#!/usr/bin/env python3
import argparse
import subprocess
import sys
import os
from pathlib import Path

CONFIG_PATH = Path.home() / ".config/vibecrate.conf"

def load_config():
    """Загружает настройки из конфиг-файла, если он есть."""
    config = {}
    if CONFIG_PATH.exists():
        with open(CONFIG_PATH) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    key, val = line.split("=", 1)
                    config[key.strip()] = val.strip()
    return config

def main():
    config = load_config()
    default_format = config.get("format", "bestvideo+bestaudio/best")

    parser = argparse.ArgumentParser(
        description="VibeCrate — загрузчик медиа с YouTube, SoundCloud, TikTok",
        epilog="Примеры:\n  vibecrate -you https://youtu.be/ и тд."
    )
    parser.add_argument("url", help="Ссылка на видео/аудио/плейлист")

    group = parser.add_mutually_exclusive_group()
    group.add_argument("-you", action="store_true", help="Установка из YouTube")
    group.add_argument("-snd", action="store_true", help="Установка из SoundCloud")
    group.add_argument("-tt",  action="store_true", help="Установка из TikTok")

    parser.add_argument("-f", "--format", default=default_format,
                        help=f"Формат/качество (по умолчанию: {default_format})")
    parser.add_argument("-c", "--cookies", metavar="BROWSER",help="Использовать куки из браузера")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    cmd = ["yt-dlp", "-o", f"{Path.home()}/Downloads/%(title)s.%(ext)s"]

    if args.you:
        cmd.extend(["-f", "bestvideo+bestaudio/best"])
    elif args.snd:
        cmd.extend(["-x", "--audio-format", "mp3", "-f", "bestaudio"])
    elif args.tt:
        cmd.extend(["--no-playlist", "-f", "bestvideo+bestaudio/best"])
    else:
        cmd.extend(["-f", args.format])
    if args.cookies:
        cmd.append(f"--cookies-from-browser={args.cookies}")

    cmd.append(args.url)

    print(f"Загружаем: {args.url}")
    try:
        subprocess.run(cmd, check=True)
        print(f"Готово! Файлы в ~/Downloads")
    except subprocess.CalledProcessError as e:
        print("Ошибка:", e)

if __name__ == "__main__":
    main()
