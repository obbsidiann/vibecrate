#!/usr/bin/env python3
import argparse
import subprocess
import sys
import os
from pathlib import Path

CONFIG_PATH = Path.home() / ".config/vibecrate.conf"

def load_config():
    """Загружает настройки из конфиг-файла, если он есть."""
    config = {}
    if CONFIG_PATH.exists():
        with open(CONFIG_PATH) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    key, val = line.split("=", 1)
                    config[key.strip()] = val.strip()
    return config

def main():
    # Загружаем конфиг (пока только для формата по умолчанию)
    config = load_config()
    default_format = config.get("format", "bestvideo+bestaudio/best")

    parser = argparse.ArgumentParser(
        description="VibeCrate — загрузчик медиа с YouTube, SoundCloud, TikTok и др.",
        epilog="Примеры:\n  vibecrate -you https://youtu.be/...\n  vibecrate -snd https://soundcloud.com/...\n  vibecrate -tt https://tiktok.com/@user/video/..."
    )
    parser.add_argument("url", help="Ссылка на видео/аудио/плейлист")

    # Группа действий (взаимоисключающие)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("-you", action="store_true", help="YouTube: лучшее видео+аудио")
    group.add_argument("-snd", action="store_true", help="SoundCloud: скачать как MP3")
    group.add_argument("-tt",  action="store_true", help="TikTok: скачать видео (без плейлиста)")

    # Дополнительные опции
    parser.add_argument("-f", "--format", default=default_format,
                        help=f"Формат/качество (по умолчанию: {default_format})")
    parser.add_argument("-c", "--cookies", metavar="BROWSER",
                        help="Использовать куки из браузера (например: firefox, chrome)")

    # Если аргументов нет – показать help
    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    # Базовая команда
    cmd = ["yt-dlp", "-o", f"{Path.home()}/Downloads/%(title)s.%(ext)s"]

    # Применяем пресеты
    if args.you:
        # лучшее качество, можно указать ограничение по высоте, если нужно
        cmd.extend(["-f", "bestvideo+bestaudio/best"])
    elif args.snd:
        cmd.extend(["-x", "--audio-format", "mp3", "-f", "bestaudio"])
    elif args.tt:
        cmd.extend(["--no-playlist", "-f", "bestvideo+bestaudio/best"])
    else:
        # Если ни один флаг не указан – используем формат из конфига или дефолтный
        cmd.extend(["-f", args.format])

    # Добавляем куки, если запрошено
    if args.cookies:
        cmd.append(f"--cookies-from-browser={args.cookies}")

    # Всегда запрещаем плейлист, если не TikTok? Но можно оставить как есть
    # Лучше для TT мы уже указали --no-playlist, для остальных по умолчанию yt-dlp сам определяет.
    # Но если пользователь явно хочет плейлист, он может указать -p, но мы убрали -p.
    # Оставим без дополнительных флагов.

    cmd.append(args.url)

    print(f"🚀 Загружаем: {args.url}")
    try:
        subprocess.run(cmd, check=True)
        print(f"✅ Готово! Файлы в ~/Downloads")
    except subprocess.CalledProcessError as e:
        print("❌ Ошибка:", e)

if __name__ == "__main__":
    main()
